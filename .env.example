CAMPUS_NAME=西安电子科技大学
BUNDLED_KNOWLEDGE_ENABLED=true
BUNDLED_KNOWLEDGE_DIR=knowledge/xidian
AGENT_FRAMEWORK=event_driven_multi_agent
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mindbridge-qwen2.5-7b-ft:latest
FINETUNED_MODEL_NAME=mindbridge-qwen2.5-7b-ft:latest
FINETUNED_MODEL_DIR=models/mindbridge-qwen2.5-7b-ft
FINETUNED_MODEL_FILE=mindbridge-qwen2.5-7b-ft-q4_k_m.gguf
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# 仅在兼容供应商支持时设置；避免思考内容耗尽输出预算导致正文为空。
# OPENAI_ENABLE_THINKING=false
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# 离线 LLM-as-Judge 专用配置。不要与被测模型密钥混用，也不要提交真实密钥。
JUDGE_BASE_URL=https://api.openai.com/v1
JUDGE_API_KEY=
JUDGE_MODEL=gpt-4o-mini
JUDGE_TEMPERATURE=0
JUDGE_TIMEOUT_SECONDS=90
DATABASE_URL=mysql+pymysql://mindbridge:mindbridge@127.0.0.1:3306/mindbridge?charset=utf8mb4
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_MEMORY_TTL_SECONDS=86400
REDIS_MEMORY_MAX_MESSAGES=40
REDIS_SOCKET_TIMEOUT_SECONDS=2
MEMORY_ROLLING_SUMMARY_ENABLED=true
MEMORY_RECENT_TARGET_MESSAGES=8
MEMORY_COMPACTION_TRIGGER_MESSAGES=12
MEMORY_SUMMARY_MAX_TOKENS=600
MEMORY_SUMMARY_SCHEMA_VERSION=1
MEMORY_PROMPT_HIGH_WATERMARK_RATIO=0.65
MEMORY_PROMPT_TARGET_RATIO=0.40
MODEL_CONTEXT_WINDOW_TOKENS=32768
RESERVED_OUTPUT_TOKENS=1024
RAG_SKILL_BUDGET_TOKENS=4000
MEMORY_MAINTENANCE_QUEUE_ENABLED=true
MEMORY_MAINTENANCE_POLL_INTERVAL_SECONDS=1
MEMORY_MAINTENANCE_MAX_ATTEMPTS=3
SAFETY_MEMORY_ENABLED=true
SAFETY_STATE_SCOPE=session
SAFETY_STATE_CACHE_TTL_SECONDS=900
SAFETY_MONITORING_RISK_FLOOR=MEDIUM
SAFETY_REVIEW_INTERVAL_SECONDS=86400
SAFETY_REVIEW_NORMAL_TURNS=10
SAFETY_HIGH_TO_MONITORING_MIN_SAFE_ASSESSMENTS=2
SAFETY_MEDIUM_TO_LOW_MIN_CONSECUTIVE_LOW=2
SAFETY_LOW_TO_RESOLVED_MIN_ADDITIONAL_LOW=1
SERVER_HOST=127.0.0.1
SERVER_PORT=8080
KNOWLEDGE_TOP_K=4
KNOWLEDGE_CANDIDATE_K=16
KNOWLEDGE_PARENT_CHUNK_SIZE=1000
KNOWLEDGE_CHUNK_SIZE=300
KNOWLEDGE_CHUNK_OVERLAP=40
KNOWLEDGE_PARENT_VECTOR_WEIGHT=0.30
KNOWLEDGE_CHILD_VECTOR_WEIGHT=0.35
KNOWLEDGE_HYBRID_VECTOR_WEIGHT=0.65
KNOWLEDGE_HYBRID_BM25_WEIGHT=0.35
KNOWLEDGE_RERANK_ENABLED=false
KNOWLEDGE_VECTOR_ENABLED=true
KNOWLEDGE_VECTOR_REQUIRED=false
CHROMA_PERSIST_DIR=data/chroma
CHROMA_COLLECTION_NAME=mindbridge_knowledge
CHROMA_SNAPSHOT_DIR=data/chroma-snapshots
CHROMA_SNAPSHOT_KEEP=5
EMBEDDING_TIMEOUT_SECONDS=30
RAG_EVAL_ENABLED=false
RAG_EVAL_EXIT_AFTER_RUN=false
TOOL_QUEUE_ENABLED=true
TOOL_QUEUE_POLL_INTERVAL_SECONDS=1
TOOL_QUEUE_BATCH_SIZE=10
TOOL_QUEUE_MAX_ATTEMPTS=3
TOOL_QUEUE_RETRY_DELAY_SECONDS=15
TOOL_QUEUE_EXCEL_WORKERS=1
TOOL_QUEUE_EMAIL_WORKERS=2
ALERT_EMAIL_RATE_LIMIT_PER_MINUTE=30
ALERT_EMAIL_DELIVERY_MODE=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=10
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
ALERT_EMAIL_SUBJECT_PREFIX=[MindBridge 高风险预警]
